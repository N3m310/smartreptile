{
  // Local development overrides. No secrets here — use .env / user secrets / environment variables.
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information",
      "SmartReptile": "Debug"
    }
  },
  "ConnectionStrings": {
    // Matches the host-published port of the `db` service in docker-compose.yml. The port is 14330 rather than
    // 1433 so that a second local SQL Server stack (the aeroponic-iot project) can run at the same time.
    // Override with an env var in CI or in a container.
    "Default": "Server=localhost\\SQLEXPRESS;Database=SmartReptile;User Id=sa;Password=12345;TrustServerCertificate=True;Encrypt=False"
  },
  "Jwt": {
    "SigningKey": "development-only-signing-key-change-me-32chars"
  },
  "Mqtt": {
    "Host": "0.0.0.0",
    // Kept on: the broker verifies the device credential (FR-05 BR-05.1), and a local run is exactly where that
    // check has to be exercised. Turn it off only to test a transport without provisioning a device first.
    "RequireClientAuthentication": true
  },
  "Provisioning": {
    "SharedKey": "development-only-shared-key"
  },
  "PasswordReset": {
    // Development has no mail server, so the generated code is written to the log; without it the flow cannot be
    // completed locally. Never enable this outside a development environment.
    "LogCode": true
  },
  "Notifications": {
    "Smtp": {
      // The development stack runs Mailpit beside the API (docker-compose.yml), so the out-of-band channel has a
      // local sink and 3.5's escalation ladder can be demonstrated without a real mail account. A local run without
      // Compose has nothing listening on 1025 and simply records a failed attempt, which is the honest outcome.
      "Enabled": true,
      "Host": "localhost",
      "Port": 1025,
      "FromAddress": "no-reply@smartreptile.local"
    }
  },
  "Admin": {
    // A development placeholder, not a secret, and the same kind of value Jwt:SigningKey is below: it exists so a
    // local database has one account that can author the species-profile catalogue (FR-10), because registration
    // only ever produces an Owner. A deployment sets Admin__Username/Admin__Email/Admin__Password instead, which
    // is why this file is the only one that fills the section in.
    "Username": "admin",
    "Email": "admin@vivariumguard.vn",
    "Password": "Admin#2026"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:8081",
      "http://localhost:8080"
    ]
  }
}
