{
  // Local development overrides. No secrets here — use .env / user secrets / environment variables.
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information",
      "SmartReptile": "Debug"
    }
  },
  "ConnectionStrings": {
    // Matches the host-published port of the `db` service in docker-compose.yml. The port is 14330 rather than
    // 1433 so that a second local SQL Server stack (the aeroponic-iot project) can run at the same time.
    // Override with an env var in CI or in a container.
    "Default": "Server=localhost\\SQLEXPRESS;Database=SmartReptile;User Id=sa;Password=12345;TrustServerCertificate=True;Encrypt=False"
  },
  "Jwt": {
    "SigningKey": "development-only-signing-key-change-me-32chars"
  },
  "Mqtt": {
    "Host": "0.0.0.0",
    // Kept on: the broker verifies the device credential (FR-05 BR-05.1), and a local run is exactly where that
    // check has to be exercised. Turn it off only to test a transport without provisioning a device first.
    "RequireClientAuthentication": true
  },
  "Provisioning": {
    "SharedKey": "development-only-shared-key"
  },
  "PasswordReset": {
    // Development has no mail server, so the generated code is written to the log; without it the flow cannot be
    // completed locally. Never enable this outside a development environment.
    "LogCode": true
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:8081",
      "http://localhost:8080"
    ]
  }
}
