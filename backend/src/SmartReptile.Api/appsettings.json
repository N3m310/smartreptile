{
  "Version": "0.1.0",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "SmartReptile": "Information"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": ""
  },
  "Jwt": {
    "SigningKey": "",
    "Issuer": "SmartReptile",
    "Audience": "SmartReptile",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "Mqtt": {
    "Host": "0.0.0.0",
    "Port": 1883,
    "TlsPort": 8883,
    "EnableTls": false,
    "DisablePlaintextEndpoint": false,
    "ServerCertificatePath": "",
    "ServerCertificatePassword": "",
    "RequireClientAuthentication": true,
    "DeviceTopicPrefix": "sr/v1/d"
  },
  "Provisioning": {
    "SharedKey": "",
    "ClaimCodeMinutes": 15,
    "ClaimCodeAlphabet": "23456789ABCDEFGHJKMNPQRSTUVWXYZ",
    "ClaimCodeLength": 8
  },
  "Retention": {
    "RawDays": 90,
    "RollupMonths": 24,
    "SnapshotDays": 7,
    "PurgeBatchSize": 10000
  },
  "Defaults": {
    "TimeZoneId": "Asia/Ho_Chi_Minh",
    "SamplingIntervalSec": 60,
    "SilentAfterIntervals": 3
  },
  "Ingest": {
    "HttpFallbackEnabled": true,
    "MaxSamplesPerBatch": 120,
    "MaxPayloadKb": 32,
    "BackfillNotifyCutoffHours": 6
  },
  "OnboardingProtection": {
    "MaxAttemptsPerIp": 1,
    "WindowMinutes": 5,
    "MaxAttemptsPerHourGlobal": 20
  },
  "Startup": {
    "ApplyMigrationsOnStartup": true,
    "SeedReferenceDataOnStartup": true
  },
  "Cors": {
    "AllowedOrigins": []
  }
}
