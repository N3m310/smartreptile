{
  "Version": "0.1.0",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "SmartReptile": "Information"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": ""
  },
  "Jwt": {
    "SigningKey": "",
    "Issuer": "SmartReptile",
    "Audience": "SmartReptile",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "Mqtt": {
    "Host": "0.0.0.0",
    "PlaintextHost": "127.0.0.1",
    "Port": 1883,
    "TlsPort": 8883,
    "EnableTls": false,
    "DisablePlaintextEndpoint": false,
    "ServerCertificatePath": "",
    "ServerCertificatePassword": "",
    "RequireClientAuthentication": true,
    "DeviceTopicPrefix": "sr/v1/d"
  },
  "Provisioning": {
    "SharedKey": "",
    "ClaimCodeMinutes": 15,
    "ClaimCodeAlphabet": "23456789ABCDEFGHJKMNPQRSTUVWXYZ",
    "ClaimCodeLength": 8
  },
  "Retention": {
    "RawDays": 90,
    "RollupMonths": 24,
    "SnapshotDays": 7,
    "PurgeBatchSize": 10000
  },
  "Defaults": {
    "TimeZoneId": "Asia/Ho_Chi_Minh",
    "SamplingIntervalSec": 60,
    "SilentAfterIntervals": 3
  },
  "Ingest": {
    "HttpFallbackEnabled": true,
    "MaxSamplesPerBatch": 120,
    "MaxPayloadKb": 32,
    "BackfillNotifyCutoffHours": 6
  },
  "OnboardingProtection": {
    "MaxAttemptsPerIp": 1,
    "WindowMinutes": 5,
    "MaxAttemptsPerHourGlobal": 20
  },
  "PasswordReset": {
    "CodeMinutes": 30,
    // Off: a live reset credential in a log is a credential leak. Development turns it on because development has
    // no delivery channel at all (see PasswordResetOptions).
    "LogCode": false
  },
  "Notifications": {
    // The dispatcher's sweep (FR-13, roadmap 3.5). Every rule it applies — the 10-per-hour cap, the 60-minute
    // repeat cooldown, the 5 s / 30 s / 2 min retry backoff, the 30 / 60 / 120 minute escalation ladder, quiet
    // hours — is a constant in the domain, so a deployment cannot move what a keeper is promised.
    "SweepSeconds": 15,
    "Fcm": {
      // Off until a service-account file is mounted. Compose mounts it read-only; nothing puts a credential here.
      "Enabled": false,
      "ServiceAccountJsonPath": ""
    },
    "Smtp": {
      // Off by default: the out-of-band channel is a deliberate choice, and a deployment with no relay should say
      // so rather than fail a delivery. The development compose stack turns it on against Mailpit, which is the
      // local sink TC-I-12 asks for and what makes §02-design/05 §6's 120-minute step demonstrable offline.
      "Enabled": false,
      "Host": "127.0.0.1",
      "Port": 1025,
      "UseStartTls": false,
      "Username": "",
      "Password": "",
      "FromAddress": "no-reply@smartreptile.local",
      "FromName": "SmartReptile"
    }
  },
  "Startup": {
    "ApplyMigrationsOnStartup": true,
    "SeedReferenceDataOnStartup": true
  },
  "Admin": {
    // The system administrator (FR-10): the one account that may author the species-profile catalogue, since
    // registration only ever produces an Owner. Empty here — no administrator is seeded unless a deployment names
    // one — with this file's environment-variable overrides doing it in a real deployment:
    //   Admin__Username / Admin__Email / Admin__Password
    // The section is also the switch: a deployment with no administrator simply leaves it empty.
    "Username": "",
    "Email": "",
    "Password": ""
  },
  "Cors": {
    "AllowedOrigins": []
  }
}
