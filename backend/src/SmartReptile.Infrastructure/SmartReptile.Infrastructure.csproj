<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Infrastructure: EF Core, MQTT broker, notification channels, health checks.
    It implements Application interfaces; it never makes business decisions (§02-design/01 §4).
  -->
  <PropertyGroup>
    <RootNamespace>SmartReptile.Infrastructure</RootNamespace>
    <AssemblyName>SmartReptile.Infrastructure</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SmartReptile.Domain\SmartReptile.Domain.csproj" />
    <ProjectReference Include="..\SmartReptile.Application\SmartReptile.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The Web SDK adds these implicitly for the API; a class library needs them declared. -->
    <Using Include="Microsoft.Extensions.Logging" />
    <Using Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.2" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.2" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="10.0.2" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.Abstractions" Version="10.0.2" />
    <!-- IHttpClientFactory for the push channel: the API gets this from the ASP.NET Core shared framework, a class
         library does not. -->
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.2" />
    <PackageReference Include="MQTTnet" Version="4.3.7.1207" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.23.0" />
    <!--
      Pinned directly to keep it above the version Microsoft.Data.SqlClient still pulls in transitively (9.0.4),
      which carries GHSA-2fmv-rv2c-59x7 and GHSA-846f-f764-76mx. Nothing here uses the type directly; the pin is
      what `TreatWarningsAsErrors` needs, because NU1902/NU1903 arrive as warnings and became build errors.
    -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>
</Project>
