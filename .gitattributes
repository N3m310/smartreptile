# Normalise line endings so the CI formatting gate (dotnet format --verify-no-changes) does not fail on the
# difference between a Windows checkout and a Linux runner.
* text=auto eol=lf

# cmd.exe reads a batch file line by line and mis-parses a parenthesised block (`if ... (` / `for ... do (`) that
# arrives without CRLF — the launchers exit 9009 with a mangled command instead of running. Keep them CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

*.png binary
*.jpg binary
*.pdf binary
*.apk binary
*.aab binary
