root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,md,html,css,js}]
indent_size = 2

[*.cs]
indent_size = 4
# Requirement ids appear in comments on purpose (§03-implementation/02 §5).
max_line_length = 140

[*.dart]
indent_size = 2

[*.ino]
indent_size = 2
