root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,md,html,css,js}]
indent_size = 2

[*.cs]
indent_size = 4
# Requirement ids appear in comments on purpose (§03-implementation/02 §5).
max_line_length = 140

[*.dart]
indent_size = 2

[*.ino]
indent_size = 2

# EF Core migrations are generated by tooling, not written by hand: on Windows the generator emits CRLF and a
# BOM, which the CI formatting gate would otherwise reject on every new migration. Marking them as generated
# keeps `dotnet format --verify-no-changes` meaningful for the code we actually author.
[backend/src/SmartReptile.Infrastructure/Persistence/Migrations/*.cs]
generated_code = true
end_of_line = unset
charset = unset
