<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only. Lives in `src/debug/`, so Gradle merges it over `src/main/res/xml/network_security_config.xml`
     for the debug variant and the release APK keeps the strict main file (cleartext to 10.0.2.2/localhost only).

     Why: the FR-17 demo camera is a phone running an MJPEG server or an ESP32-CAM, at a LAN address that differs per
     lab and answers on plain http://. Android refuses cleartext to an address the main config does not name, which
     would surface as "CLEARTEXT communication ... not permitted" inside the camera screen. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
