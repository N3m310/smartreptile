# SmartReptile environment template — copy to .env and fill in.
# Every value here is a placeholder. NEVER commit the real .env (see .gitignore).

# ---- SQL Server (used by the `db` service and the API connection string) ----
MSSQL_SA_PASSWORD=

# NOTE: docker compose builds its own connection string from MSSQL_SA_PASSWORD (see docker-compose.yml) because
# Compose does not expand ${...} inside .env values. DB_CONNECTION_STRING is therefore only used when running
# the API outside Docker (dotnet run) against the host-published port, which is 14330 so that it does not clash
# with other local stacks (the aeroponic-iot project binds 1433).
#
# Use 127.0.0.1, not localhost: the container publishes the port on IPv4 only, while on Windows `localhost`
# resolves to ::1 first. Docker Desktop does not proxy ::1, so the client hangs until the connect timeout
# expires (SqlException 258) instead of failing fast and retrying over IPv4.
DB_CONNECTION_STRING=Server=127.0.0.1,14330;Database=SmartReptile;User Id=sa;Password=CHANGE_ME;TrustServerCertificate=True;Encrypt=False

# ---- Auth ----
# Base64 or plain string, minimum 32 characters (validated at startup).
JWT_SIGNING_KEY=
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=30

# ---- MQTT broker (hosted inside the API process) ----
MQTT_HOST=0.0.0.0
MQTT_PORT=1883
MQTT_TLS_PORT=8883
MQTT_ENABLE_TLS=false
MQTT_DISABLE_PLAINTEXT=false
MQTT_SERVER_CERT_PATH=
MQTT_SERVER_CERT_PASSWORD=
MQTT_REQUIRE_CLIENT_AUTH=true

# ---- Device provisioning ----
PROVISIONING_SHARED_KEY=
PROVISIONING_CLAIM_CODE_MINUTES=15

# ---- Alert channels (all optional; the in-app inbox always works) ----
TELEGRAM_BOT_TOKEN=
FCM_SERVICE_ACCOUNT_PATH=
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
FROM_EMAIL=

# ---- Retention (FR-15) ----
RETENTION_RAW_DAYS=90
RETENTION_ROLLUP_MONTHS=24

# ---- Platform behaviour ----
DEFAULT_TIMEZONE=Asia/Ho_Chi_Minh
INGEST_HTTP_FALLBACK_ENABLED=true
STARTUP_APPLY_MIGRATIONS=true
STARTUP_SEED_REFERENCE_DATA=true

# ---- Observability ----
OTEL_SERVICE_NAME=SmartReptile
OTEL_TRACE_SAMPLE_RATIO=0.25
OTEL_EXPORTER_OTLP_ENDPOINT=

# ---- CORS (comma separated origins for the web dashboard) ----
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:5173
